# Dependencies
node_modules/
.pnp/
.pnp.js

# Playwright artifacts. `playwright-report/` is the deep-trace reference a human
# opens with `npm run report`; it is regenerated by every run and must never be
# committed (a single run is ~225 MB of traces, videos and screenshots).
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# Generated per-run digest. BUG_REPORT.md / BUG_REPORT.json are deliberately NOT
# ignored — they are the deliverable this suite hands to developers and are
# meant to be reviewed in diffs, exactly as in the API bench.
DEV_DIGEST.md
DEV_DIGEST.json

# Authentication / session storage state (NEVER commit real sessions)
/.auth/
*.storageState.json

# Environment secrets
.env
.env.*
!.env.example

# Build output
/dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
