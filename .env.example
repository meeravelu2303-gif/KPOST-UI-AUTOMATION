# ---------------------------------------------------------------------------
# KPost UI Automation — Environment Configuration Template
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# All values here are safe placeholders — never commit real credentials.
# ---------------------------------------------------------------------------

# Target environment: local | dev | staging | prod
TEST_ENV=local

# Base URL of the KPost React app under test
BASE_URL=https://localhost:3000

# API base URL (shared with the existing API automation ecosystem)
API_BASE_URL=https://localhost:3000/api

# ---- Authentication strategy for shared storage state ----
# api = fast API login (default); ui = drive the real login form once
AUTH_MODE=api
# Login endpoint, relative to API_BASE_URL (POST { email, password })
AUTH_LOGIN_PATH=/auth/login
# localStorage key the SPA reads its auth token from (token-based apps)
AUTH_TOKEN_STORAGE_KEY=kpost.authToken

# ---- Test user credentials (use non-production, seeded test accounts) ----
STANDARD_USER_EMAIL=standard.user@kpost.test
STANDARD_USER_PASSWORD=Str0ng-Passw0rd!

ADMIN_USER_EMAIL=admin.user@kpost.test
ADMIN_USER_PASSWORD=Str0ng-Admin-Passw0rd!

# ---- Execution tuning ----
# Number of parallel workers (empty = Playwright auto-detects)
WORKERS=
# Retry count for flaky tests (overrides config default when set)
RETRIES=
# Run browsers headless (true/false)
HEADLESS=true
# Slow down each action by N ms — useful for debugging only
SLOW_MO=0
