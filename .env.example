# ---------------------------------------------------------------------------
# KPost UI Automation — Environment Configuration Template
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# All values here are safe placeholders — never commit real credentials.
# ---------------------------------------------------------------------------

# Target environment: local | dev | staging | prod
TEST_ENV=local

# Base URL of the KPost React app under test
BASE_URL=https://localhost:3000

# API base URL (shared with the existing API automation ecosystem)
API_BASE_URL=https://localhost:3000/api

# ---- Authentication strategy for shared storage state ----
# api = fast API login (default); ui = drive the real login form once
AUTH_MODE=api
# Login endpoint, relative to API_BASE_URL (POST { email, password })
AUTH_LOGIN_PATH=/auth/login
# localStorage key the SPA reads its auth token from (token-based apps)
AUTH_TOKEN_STORAGE_KEY=kpost.authToken

# ---- Test user credentials (use non-production, seeded test accounts) ----
STANDARD_USER_EMAIL=standard.user@kpost.test
STANDARD_USER_PASSWORD=Str0ng-Passw0rd!

ADMIN_USER_EMAIL=admin.user@kpost.test
ADMIN_USER_PASSWORD=Str0ng-Admin-Passw0rd!

# ---- OPTIONAL: pre-onboarded KDirectory account ----
# KDirectory's search, contact list, and filters sit behind a one-time setup
# wizard (Country / Language / vertical). Completing it permanently onboards an
# account, so the standard user is deliberately left un-onboarded.
# Point these at an account that is ALREADY through the wizard and global setup
# will store a second session at .auth/directory.json, which the gated
# KDirectory specs use instead of skipping. Leave both unset to skip them.
# Set both or neither — half-configured fails fast at startup.
DIRECTORY_USER_EMAIL=
DIRECTORY_USER_PASSWORD=

# ---- OPTIONAL: recipient for the KMail send E2E test ----
# KPost rejects sending a mail to yourself ("Duplicate IDs are present in
# ToAddress..."), so the full send-success journey needs a SECOND KPOST account
# to address. It MUST be a different account than STANDARD_USER_EMAIL —
# setting it to the same address is a guaranteed rejection and the test will
# skip and tell you so. Leave unset and that test skips (the self-send
# rejection contract test still covers the whole compose/send pipeline).
MAIL_RECIPIENT=

# ---- OPTIONAL: external QA Dashboard (the separate QA-Dashboard repo) ----
# When both are set, every Playwright run posts its summary and the known
# defects it observed to POST {DASHBOARD_INGEST_URL} with
# "Authorization: Bearer {DASHBOARD_API_KEY}" (see src/reporting/
# dashboard-reporter.ts). Leave both unset and the reporter no-ops; set only
# one and startup fails fast. A dashboard outage never fails a run — the
# local playwright-report/ stays the reference either way.
DASHBOARD_INGEST_URL=
DASHBOARD_API_KEY=

# ---- Execution tuning ----
# Number of parallel workers (empty = Playwright auto-detects)
WORKERS=
# Retry count for flaky tests (overrides config default when set)
RETRIES=
# Run browsers headless (true/false)
HEADLESS=true
# Slow down each action by N ms — useful for debugging only
SLOW_MO=0
